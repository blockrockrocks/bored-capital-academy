OPENSEA_API_KEY=
ANTHROPIC_API_KEY=
# optional overrides
# BCA_TUTOR_MODEL=claude-opus-5-5
# BCA_TUTOR_EFFORT=medium
# BCA_GUARD_MODEL=claude-opus-5-5

# ---- website
BCA_BASE_URL=https://academy.example.com
BCA_SECRET_KEY=            # long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
PADDLE_ENV=sandbox         # sandbox | production
PADDLE_CLIENT_TOKEN=       # Paddle > Developer tools > Authentication > client-side token
PADDLE_API_KEY=            # server API key (only used to look up a customer's email as fallback)
PADDLE_WEBHOOK_SECRET=     # Paddle > Developer tools > Notifications > destination secret key
PADDLE_PRICE_SELF=pri_...
PADDLE_PRICE_LIVE=pri_...
PRICE_SELF_DISPLAY=€89
PRICE_LIVE_DISPLAY=€179
EMAIL_BACKEND=console      # console (writes logs/outbox) | smtp
EMAIL_FROM=Bored Capital Academy <hello@yourdomain>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TUTOR_DAILY_LIMIT=40
SURVEY_AFTER_DAYS=14
MODULE_VIDEO_URLS=         # comma-separated embed URLs for modules 1 and 2
LIVE_QA_INFO=Schedule and joining link will be emailed before each session.
